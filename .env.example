# Copy to .env and fill in. Never commit .env.

# --- Basics ---
APP_ENV=production
BASE_URL=https://hr.example.co.th          # the address people open
SECRET_KEY=                                # long random text: python -c "import secrets;print(secrets.token_urlsafe(48))"
DB_PASSWORD=                               # used by docker-compose for PostgreSQL
# DATABASE_URL is set by docker-compose. Without compose, any SQLAlchemy URL works:
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/hrhub
SESSION_HOURS=10
DEFAULT_LANGUAGE=th

# --- Google sign-in (Google Workspace) ---
# Google Cloud console > APIs & Services > Credentials > OAuth client (Web).
# Redirect URI: <BASE_URL>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ALLOWED_DOMAINS=ytrc.co.th
# App-only logins for people without a Google account (operators, supervisors)
LOCAL_LOGIN_ENABLED=true

# --- AI reading of paper forms ---
# none | anthropic | openai | gemini | mock (demo only)
AI_PROVIDER=none
AI_MODEL=
AI_API_KEY=
# For an in-house or other OpenAI-compatible server:
AI_BASE_URL=
AI_REVIEW_THRESHOLD=0.85

# --- Files (photos of forms) ---
STORAGE_DIR=/data/files

# --- Demo only: fills the database with SAMPLE people ---
DEMO_MODE=false
